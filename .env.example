# MongoDB connection string. Locally this can point to a local mongod
# instance; in Vercel it MUST point to a reachable database (e.g. MongoDB
# Atlas) since Vercel functions cannot reach `localhost`.
MONGO_URI=mongodb://localhost:27017/booking

# Port for local development only (ignored by Vercel).
PORT=3000

# NODE_ENV controls CORS origin restrictions in src/main.ts and
# src/bookings/bookings.gateway.ts. Vercel sets this to "production"
# automatically.
NODE_ENV=development
